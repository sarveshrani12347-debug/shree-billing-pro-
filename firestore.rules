rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Business Profile & Multi-Tenant Isolated Resources
    match /businesses/{businessId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.ownerUserId == request.auth.uid;

      // Business Subcollections
      match /products/{productId} {
        allow read, write: if isSignedIn();
      }

      match /invoices/{invoiceId} {
        allow read, write: if isSignedIn();
      }

      match /parties/{partyId} {
        allow read, write: if isSignedIn();
      }

      match /purchases/{purchaseId} {
        allow read, write: if isSignedIn();
      }

      match /expenses/{expenseId} {
        allow read, write: if isSignedIn();
      }

      match /dailyCashBook/{entryId} {
        allow read, write: if isSignedIn();
      }

      match /ca_monthly_summaries/{invoiceId} {
        allow read, write: if isSignedIn();
      }

      match /connected_users/{userId} {
        allow read, write: if isSignedIn();
      }

      match /qr_invitations/{invitationId} {
        allow read, write: if isSignedIn();
      }

      match /recurringInvoices/{recurringId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}

